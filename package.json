{
  "name": "reevun-windows",
  "productName": "Reevun",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Reevun for Windows",
  "author": "Reevun Software LLC",
  "main": "dist/main.js",
  "scripts": {
    "core": "npm --prefix ../app-core ci && npm --prefix ../app-core run build && node -e \"require('fs').cpSync('../app-core/dist','dist/core',{recursive:true})\"",
    "build": "npm run core && tsc",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "app.reevun.desktop",
    "productName": "Reevun",
    "copyright": "© Reevun Software LLC",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Reevun-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "shortcutName": "Reevun",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": ["ru_RU", "en_US", "de_DE", "es_ES", "tr_TR", "zh_CN"]
    },
    "publish": [{ "provider": "github", "owner": "reevun-software", "repo": "windows-app", "releaseType": "release" }]
  }
}
